# ==============================================================================
# AI Research Workbench - Environment Configuration Template
# Copy this file to .env and populate with your personal API keys as needed.
# All modules support a zero-dependency offline mock mode when keys are omitted.
# ==============================================================================

# LLM Providers (Optional for live API queries, fallback mocks available)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default Provider Selection ("gemini", "openai", or "mock")
DEFAULT_LLM_PROVIDER=mock

# Model Defaults
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Task 2: Vector Store & Embeddings Configuration
EMBEDDING_PROVIDER=local
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Task 3: Agent Sandbox Configuration
AGENT_MAX_ITERATIONS=6
AGENT_EXECUTION_TIMEOUT_SECONDS=30
AGENT_SANDBOX_DIRECTORY=./sandbox_data

# Server Port Configurations
TASK1_PORT=8501
TASK2_PORT=8502
TASK3_PORT=8503
TASK4_PORT=8504
